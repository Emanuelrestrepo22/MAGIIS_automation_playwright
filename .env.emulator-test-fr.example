# Driver app TEST + chofer FR (carrier 1901) en emulador Android. SOLO placeholders.
# Uso: copiar a `.env.emulator-test-fr` (gitignored) y correr con:
#   ENV_FILE=.env.emulator-test-fr npx tsx <script o spec>
# Las credenciales reales NO van en git ni en logs.

ENV=test

# --- Appium ---
APPIUM_SERVER_URL=http://localhost:4723
# El servidor debe arrancar con (ver README de tests/mobile/appium, sección "Driver TEST + FR"):
#   appium --allow-insecure uiautomator2:chromedriver_autodownload
# Alternativa: appium --allow-insecure chromedriver_autodownload
APPIUM_CHROMEDRIVER_AUTODOWNLOAD=true
APPIUM_NO_RESET=true

# --- Emulador (adb devices) ---
ANDROID_DRIVER_UDID=emulator-5554
ANDROID_DEVICE_NAME=sdk_gphone64_x86_64
ANDROID_PLATFORM_VERSION=15.0

# --- App: build TEST del Driver (ya resuelto por ENV=test; override solo si cambia) ---
ANDROID_DRIVER_APP_PACKAGE=com.magiis.app.test.driver

# --- Chofer FR (carrier 1901; valores reales solo en el .env local) ---
# La app ya suele estar logueada: el pre-flight verifica la identidad y solo hace login si está deslogueada.
DRIVER_EMAIL_FR=
DRIVER_PASSWORD_FR=
# Nombre tal como se ve en el header del home del Driver (pre-flight de identidad)
DRIVER_DISPLAY_NAME_FR=

# --- Ruta GPS: Boulevard de la Croisette (Cannes) -> Promenade des Anglais (Nice), ~27.3 km por ruta.
# Valores aproximados: reemplazar por puntos reales del viaje.
# Con solo origen/destino la ruta es línea recta (subestima el km vial): para fidelidad,
# pasar waypoints derivados de OSRM en GPS_ROUTE_WAYPOINTS ("lat,lng;lat,lng").
GPS_ROUTE_ORIGIN=43.5497,7.0212
GPS_ROUTE_DESTINATION=43.6947,7.2575
# GPS_ROUTE_WAYPOINTS=
# Optional: local chromedriver matching the emulator WebView
APPIUM_CHROMEDRIVER_EXECUTABLE=
