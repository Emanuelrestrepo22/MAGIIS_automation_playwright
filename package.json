{
  "name": "qa-gateway-magiis",
  "version": "1.0.0",
  "description": "Proyecto de automatización E2E para MAGIIS con Playwright + TypeScript",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "---DEV (TEST) — CANONICAL---": "─── Set canónico declarativo. Filtrado por @tags (ver docs/ci/TAGS.md) ───",
    "test:test": "cross-env ENV=test npx playwright test --project=chromium",
    "test:test:headed": "cross-env ENV=test npx playwright test --project=chromium --headed",
    "test:test:ui": "cross-env ENV=test npx playwright test --ui",
    "test:test:debug": "cross-env ENV=test npx playwright test --project=chromium --debug",
    "test:test:smoke": "cross-env ENV=test npx playwright test --project=chromium --grep=@smoke",
    "test:test:critical": "cross-env ENV=test npx playwright test --project=chromium --grep=@critical --workers=1",
    "test:test:auth": "cross-env ENV=test npx playwright test tests/features/auth/specs --project=chromium",
    "test:test:gateway": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --grep=@gateway",
    "test:test:gateway:stripe": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@stripe\" --workers=1",
    "test:test:gateway:authorize": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@authorize\" --workers=1",
    "test:test:gateway:mercadopago": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@mercadopago\" --workers=1",
    "test:test:gateway:ebizcharge": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@ebizcharge\" --workers=1",
    "test:test:gateway:stripe:xray": "cross-env ENV=test XRAY=1 XRAY_TEST_PLAN_KEY=MG-178 XRAY_OUTPUT_FILE=evidence/test/xray-results.stripe.json GATEWAYS=stripe npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@stripe\" --workers=1",
    "test:test:gateway:authorize:xray": "cross-env ENV=test XRAY=1 XRAY_TEST_PLAN_KEY=MG-178 XRAY_OUTPUT_FILE=evidence/test/xray-results.authorize.json GATEWAYS=authorize npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@authorize\" --workers=1",
    "test:test:gateway:mercadopago:xray": "cross-env ENV=test XRAY=1 XRAY_TEST_PLAN_KEY=MG-178 XRAY_OUTPUT_FILE=evidence/test/xray-results.mercadopago.json GATEWAYS=mercado-pago npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@mercadopago\" --workers=1",
    "test:test:gateway:ebizcharge:xray": "cross-env ENV=test XRAY=1 XRAY_TEST_PLAN_KEY=MG-178 XRAY_OUTPUT_FILE=evidence/test/xray-results.ebizcharge.json GATEWAYS=ebizcharge npx playwright test -c playwright.gateway-pg.config.ts --grep=\"@ebizcharge\" --workers=1",
    "test:test:gateway:3ds": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --grep=@3ds --workers=1",
    "test:test:gateway:unit": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --project=unit",
    "test:test:gateway:api": "cross-env ENV=test npx playwright test -c playwright.gateway-pg.config.ts --project=api",
    "test:uat:mx6057:api": "cross-env ENV=uat npx playwright test --project=api tests/features/gateway-pg/api/service-type-counts-reset -c playwright.gateway-pg.config.ts",
    "test:e2e:flow1": "cross-env ENV=test npx playwright test tests/e2e/gateway/flow1-carrier-driver/flow1.e2e.spec.ts --project=chromium --workers=1",
    "test:e2e:flow1:web-only": "cross-env ENV=test E2E_WEB_ONLY=true npx playwright test tests/e2e/gateway/flow1-carrier-driver/flow1.e2e.spec.ts --project=chromium --workers=1",
    "test:e2e:flow1:mobile": "cross-env ENV=test npx ts-node --esm tests/e2e/gateway/flow1-carrier-driver/mobile-phase.ts",
    "test:e2e:flow2": "cross-env ENV=test npx playwright test tests/e2e/gateway/flow2-passenger-driver/flow2.e2e.spec.ts --project=chromium --workers=1",
    "test:e2e:flow3": "cross-env ENV=test npx playwright test tests/e2e/gateway/flow3-contractor-driver/flow3.e2e.spec.ts --project=chromium --workers=1",
    "test:e2e:flow3:web-only": "cross-env ENV=test E2E_WEB_ONLY=true npx playwright test tests/e2e/gateway/flow3-contractor-driver/flow3.e2e.spec.ts --project=chromium --workers=1",
    "test:e2e:flow3:mobile": "cross-env ENV=test npx ts-node --esm tests/e2e/gateway/flow3-contractor-driver/mobile-phase.ts",
    "test:e2e:all": "cross-env ENV=test npx playwright test tests/e2e/gateway --project=chromium --workers=1",
    "test:e2e:all:web-only": "cross-env ENV=test E2E_WEB_ONLY=true npx playwright test tests/e2e/gateway --project=chromium --workers=1",
    "test:test:e2e:flow1:web": "cross-env ENV=test npx playwright test tests/e2e/flow1-carrier-driver.e2e.spec.ts --project=chromium --workers=1",
    "test:test:e2e:flow1:legacy-mobile": "cross-env ENV=test npx playwright test tests/e2e/flow1-carrier-driver.e2e.spec.ts --project=chromium --workers=1 --grep \"FLOW1-TC01-driver-app-mobile-handoff\"",
    "test:test:e2e:flow2": "cross-env ENV=test npx playwright test tests/features/gateway-pg/specs/stripe/e2e-mobile/apppax-personal-no3ds.e2e.spec.ts tests/features/gateway-pg/specs/stripe/e2e-mobile/apppax-personal-3ds.e2e.spec.ts tests/features/gateway-pg/specs/stripe/e2e-mobile/apppax-business-no3ds.e2e.spec.ts tests/features/gateway-pg/specs/stripe/e2e-mobile/apppax-business-3ds.e2e.spec.ts --project=chromium --workers=1",
    "test:test:e2e:passenger": "pnpm test:test:e2e:flow2",
    "---SMOKE BY FILE---": "─── Suite smoke por archivo (auth aún no taggeada @smoke) ───",
    "test:test:smoke:auth": "cross-env ENV=test npx playwright test tests/features/smoke/specs/portals.smoke.spec.ts --project=chromium",
    "test:test:regression": "cross-env ENV=test npx playwright test --project=chromium --grep=@regression",
    "---REGRESSION (UAT)---": "─── Regresión en UAT ───",
    "test:uat:smoke": "cross-env ENV=uat npx playwright test --project=chromium --grep=@smoke",
    "test:uat:regression": "cross-env ENV=uat npx playwright test --project=chromium --grep=@regression",
    "test:uat:headed": "cross-env ENV=uat npx playwright test --project=chromium --headed",
    "---REGRESSION (PROD)---": "─── Regresión en PROD ───",
    "test:prod:smoke": "cross-env ENV=prod npx playwright test --project=chromium --grep=@smoke",
    "test:prod:smoke:headed": "cross-env ENV=prod npx playwright test --project=chromium --headed --grep=@smoke",
    "test:prod:regression": "cross-env ENV=prod npx playwright test --project=chromium --grep=@regression",
    "---UTILS---": "─── Utilidades ───",
    "pw:install": "npx playwright install --with-deps chromium",
    "validate:terminology": "node scripts/ai/check-doc-terminology.mjs",
    "cleanup:test:travels": "cross-env ENV=test node --no-warnings --loader ts-node/esm scripts/cleanup/cleanup-test-travels.ts",
    "cleanup:test:travels:dry": "cross-env ENV=test node --no-warnings --loader ts-node/esm scripts/cleanup/cleanup-test-travels.ts --dry-run",
    "test:plan": "npx playwright test --reporter=list --project=chromium --list",
    "test:ui": "npx playwright test --ui",
    "test:trace": "npx playwright show-trace",
    "appium:mcp:driver:config": "node tests/mobile/appium/scripts/generateAppiumMcpConfig.mjs driver",
    "appium:mcp:passenger:config": "node tests/mobile/appium/scripts/generateAppiumMcpConfig.mjs passenger",
    "appium:mcp:help": "node tests/mobile/appium/scripts/generateAppiumMcpConfig.mjs --help",
    "mobile:driver:home-dump": "cross-env ANDROID_DRIVER_APP_PACKAGE=com.magiis.app.test.driver pnpm exec ts-node --esm tests/mobile/appium/scripts/dump-driver-home.ts",
    "mobile:driver:login-smoke": "cross-env ANDROID_DRIVER_APP_PACKAGE=com.magiis.app.test.driver pnpm exec ts-node --esm tests/mobile/appium/scripts/driver-login-smoke.ts",
    "mobile:passenger:home-dump": "cross-env ANDROID_APP_PACKAGE=com.magiis.app.test.passenger SCREEN_LABEL=passenger-home pnpm exec ts-node --esm tests/mobile/appium/scripts/dump-current-screen.ts",
    "mobile:passenger:profile-mode-smoke": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=test ANDROID_PASSENGER_APP_PACKAGE=com.magiis.app.test.passenger NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-home-mode-smoke.ts",
    "mobile:passenger:wallet-cleanup": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=test ANDROID_PASSENGER_APP_PACKAGE=com.magiis.app.test.passenger NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-wallet-cleanup.ts",
    "mobile:passenger:personal-3ds-hold-flow": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=test ANDROID_PASSENGER_APP_PACKAGE=com.magiis.app.test.passenger NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-personal-3ds-hold-flow.ts",
    "mobile:passenger:business-no3ds-hold-flow": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=test ANDROID_PASSENGER_APP_PACKAGE=com.magiis.app.test.passenger NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-business-no3ds-hold-flow.ts",
    "mobile:passenger:wallet-3ds-delete": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=test ANDROID_PASSENGER_APP_PACKAGE=com.magiis.app.test.passenger NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-wallet-3ds-delete.ts",
    "mobile:passenger:login-dump": "cross-env ANDROID_APP_PACKAGE=com.magiis.app.test.passenger pnpm exec ts-node --esm tests/mobile/appium/scripts/passenger-login-and-dump.ts",
    "appium:passenger:login-dump": "pnpm exec ts-node --esm tests/mobile/appium/scripts/passenger-login-and-dump.ts",
    "clean:evidence": "rm -rf evidence",
    "clean:all": "rm -rf evidence test-results playwright-report allure-results allure-report",
    "allure:gen": "allure generate ./allure-results -o allure-report",
    "allure:open": "allure open allure-report",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts --fix",
    "prettier:check": "npx prettier --check tests/**/*.ts",
    "prettier:fix": "npx prettier --write tests/**/*.ts",
    "check:ts": "tsc --noEmit",
    "test:login": "pnpm exec playwright test tests/features/auth/specs/login-success.e2e.spec.ts --project=chromium",
    "test:login:headed": "pnpm exec playwright test tests/features/auth/specs/login-success.e2e.spec.ts --project=chromium --headed",
    "pp": "node scripts/ci/pre-push.mjs",
    "prepush": "node scripts/ci/pre-push.mjs",
    "prepare": "husky",
    "ci:report": "node scripts/ci/weekly-ci-report.mjs",
    "ci:sync-check": "node scripts/ci/check-remote-sync.mjs",
    "sync:trello": "node --no-warnings --loader ts-node/esm scripts/trello/sync-backlog-to-trello.ts",
    "sync:trello:dry": "node --no-warnings --loader ts-node/esm scripts/trello/sync-backlog-to-trello.ts --dry",
    "scaffold:feature": "node --no-warnings --loader ts-node/esm scripts/scaffold-feature.ts",
    "scaffold:feature:dry": "node --no-warnings --loader ts-node/esm scripts/scaffold-feature.ts --dry-run",
    "mobile:passenger:surface-census:uat": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=uat NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-surface-census.ts",
    "mobile:passenger:token-scope:uat": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=uat NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-mg116-token-scope.ts",
    "mobile:passenger:cancel-trip:uat": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=uat NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-cancel-active-trip.ts",
    "mobile:passenger:address-battery:uat": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=uat NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-mg116-uat-battery.ts",
    "mobile:passenger:address-cases:uat": "cross-env APPIUM_SERVER_URL=http://localhost:4723 ENV=uat NODE_OPTIONS=--experimental-specifier-resolution=node node --loader ts-node/esm tests/mobile/appium/scripts/passenger-mg116-uat-cases.ts",
    "test:uat:mg116:address-guards": "cross-env ENV=uat APPIUM_SERVER_URL=http://localhost:4723 npx playwright test tests/mobile/appium/passenger/specs/pax-address-surfaces.spec.ts --project=chromium --workers=1",
    "test:uat:mg116:behaviors": "cross-env ENV=uat APPIUM_SERVER_URL=http://localhost:4723 npx playwright test tests/mobile/appium/passenger/specs/pax-address-behaviors.spec.ts --project=chromium --workers=1",
    "test:uat:mg116:all": "cross-env ENV=uat APPIUM_SERVER_URL=http://localhost:4723 ALLURE=1 npx playwright test tests/mobile/appium/passenger/specs/pax-address-behaviors.spec.ts tests/mobile/appium/passenger/specs/pax-address-surfaces.spec.ts --project=chromium --workers=1",
    "test:uat:mg117:address-guards": "cross-env ENV=uat APPIUM_SERVER_URL=http://localhost:4723 npx playwright test tests/mobile/appium/driver/specs/driver-address-surfaces.spec.ts --project=chromium --workers=1",
    "test:uat:mg116:api": "cross-env ENV=uat playwright test --config=playwright.mg116-api.config.ts",
    "test:test:mg116:api": "cross-env ENV=test playwright test --config=playwright.mg116-api.config.ts"
  },
  "keywords": [
    "playwright",
    "e2e",
    "typescript",
    "automation",
    "qa",
    "testing",
    "magiis"
  ],
  "author": "MAGIIS QA Team",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@types/oracledb": "^7.0.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@wdio/globals": "^9.27.0",
    "allure": "^3.14.3",
    "allure-playwright": "^3.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-playwright": "^2.10.3",
    "eslint-plugin-prettier": "^5.5.4",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.0.0",
    "prettier-eslint": "^16.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webdriverio": "^9.27.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "openai": "^6.33.0",
    "oracledb": "^7.0.1"
  }
}
