{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@pages/*": ["./tests/pages/*"],
      "@helpers/*": ["./tests/helpers/*"],
      "@fixtures/*": ["./tests/fixtures/*"],
      "@features/*": ["./tests/features/*"],
      "@config/*": ["./tests/config/*"],
      "@utils/*": ["./tests/utils/*"],
      "@TestBase": ["./tests/TestBase.ts"]
    }
  },
  "include": [
    "./**/*.ts",
    "global-setup.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results",
    "dist",
    "coverage"
  ]
}
