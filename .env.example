# ─────────────────────────────────────────────────────────────────────────────
# qa-gateway-magiis — Plantilla de variables de entorno
#
# Cómo usar:
#   1. Copiar a .env.test, .env.uat o .env.prod según el ambiente activo.
#   2. Completar valores. Los archivos .env.<env> están en .gitignore.
#   3. ENV controla qué .env carga (`ENV=test` → `.env.test`).
#
# Convención de credenciales:
#   <PREFIX>_<ROLE>_<ENV>  →  <PREFIX>_<ROLE>  →  legacy fallback
#   Ej: USER_CARRIER_TEST  → USER_CARRIER       → (sin legacy)
#       USER_PAX_TEST      → USER_PAX           → PAX_USER (legacy)
#       DRIVER_EMAIL_TEST  → DRIVER_EMAIL       → (sin legacy)
#
# Referencias:
#   - tests/config/runtime.ts                      (roles web)
#   - tests/fixtures/users/web-portals/*.ts        (resolución lazy por env)
#   - tests/fixtures/users/mobile/*.ts             (driver / passenger)
#   - tests/mobile/appium/config/appiumRuntime.ts  (capabilities Android)
#   - docs/ci/MERGE-POLICY.md                      (manejo de creds en CI)
# ─────────────────────────────────────────────────────────────────────────────


# ─── Ambiente activo ─────────────────────────────────────────────────────────
ENV=test
# ENV_FILE=.env.custom        # opcional, override del archivo cargado
HEADLESS=true


# ─── Portal web — URLs y rutas ───────────────────────────────────────────────
BASE_URL=https://apps-test.magiis.com
AUTH_API_URL=
LOGIN_PATH="/#/authentication/login/carrier"
# LOGIN_PATH_CARRIER="/#/authentication/login/carrier"
# LOGIN_PATH_CONTRACTOR="/#/authentication/login/contractor"
# LOGIN_PATH_WEB="/#/authentication/login"
DASHBOARD_URL_PATTERN=dashboard
# TEST_ROLE=carrier           # opcional, default carrier


# ─── Credenciales web por rol (sufijo _TEST | _UAT | _PROD opcional) ─────────
# Convención por PASARELA (sufijo de gateway, opcional): para correr un rol web con
# credenciales específicas de un gateway, agregar el sufijo del gateway. Cadena de
# resolución cuando el login recibe `{ gateway }`:
#   USER_<ROLE>_<GW>_<ENV>  →  USER_<ROLE>_<GW>  →  USER_<ROLE>_<ENV>  →  USER_<ROLE>
# Sufijos: STRIPE (default, sin gateway) · MP (mercado-pago) · AUTHORIZE · EBIZ (ebizcharge).
#   Ej: USER_CARRIER_MP=       # carrier de MercadoPago (ARG)
#       PASS_CARRIER_MP=
#       USER_CONTRACTOR_MP=    # contractor de MercadoPago (ARG)
#       PASS_CONTRACTOR_MP=
USER_CARRIER=
PASS_CARRIER=
# USER_CARRIER_TEST=
# PASS_CARRIER_TEST=

# Carrier por pasarela (S9 — cadena de resolución de loginAsDispatcher({ gateway })).
# Si el carrier de la pasarela difiere del default (Stripe), setear el par por sufijo:
USER_CARRIER_AUTHORIZE=
PASS_CARRIER_AUTHORIZE=
USER_CARRIER_EBIZ=
PASS_CARRIER_EBIZ=
# USER_CARRIER_MP=
# PASS_CARRIER_MP=

USER_CONTRACTOR=
PASS_CONTRACTOR=

USER_WEB=
PASS_WEB=

# Pax web (Stripe E2E mobile / hybrid). Legacy fallback: PAX_USER / PAX_PASS
USER_PAX=
PASS_PAX=


# ─── Cleanup helpers (tests/features/gateway-pg/helpers/travel-cleanup.ts) ──
# ID estable del dispatcher en TEST (no es credencial rotable).
# Default hardcoded: 6715. Sobrescribir si cambia el ambiente.
# CARRIER_USER_ID=6715


# ─── Mobile — credenciales por actor (sufijo _TEST | _UAT | _PROD opcional) ─
DRIVER_EMAIL=
DRIVER_PASSWORD=
# DRIVER_EMAIL_TEST=
# DRIVER_PASSWORD_TEST=

PASSENGER_EMAIL=
PASSENGER_PASSWORD=
# PASSENGER_EMAIL_TEST=
# PASSENGER_PASSWORD_TEST=


# ─── Appium / Android ────────────────────────────────────────────────────────
APPIUM_SERVER_URL=http://localhost:4723
# APPIUM_BASE_PATH=/
# APPIUM_NEW_COMMAND_TIMEOUT=120   # segundos
# APPIUM_NO_RESET=true             # default true cuando la app YA está instalada
# APPIUM_FULL_RESET=false

# Packages instalados en el emulador. Defaults por ambiente viven en
# appiumRuntime.ts: com.magiis.app.<env>.<actor>. Estas vars son override.
# ANDROID_DRIVER_APP_PACKAGE=com.magiis.app.test.driver
# ANDROID_PASSENGER_APP_PACKAGE=com.magiis.app.test.passenger

# Modo APK (solo si la app NO está instalada en el emulador):
# ANDROID_DRIVER_APP_PATH=/ruta/absoluta/driver.apk
# ANDROID_PASSENGER_APP_PATH=/ruta/absoluta/passenger.apk

# Dispositivo
ANDROID_DEVICE_NAME=Pixel_7
ANDROID_PLATFORM_VERSION=15.0
# ANDROID_UDID=emulator-5554

# Toolchain Android (host machine, no consumido por Playwright)
ANDROID_HOME=
ANDROID_SDK_ROOT=
JAVA_HOME=


# ─── Gateway sandboxes ───────────────────────────────────────────────────────
# Stripe: NO requiere keys — los outcomes se disparan por número de tarjeta.
# Ver: tests/fixtures/gateways/stripe/cards.ts

# Authorize.net (BL-025): coordinar Merchant Interface sandbox + claves.
# Ver: docs/gateway-pg/authorize/EXTERNAL-BLOCKERS.md §1
AUTHORIZE_API_LOGIN_ID=
AUTHORIZE_TRANSACTION_KEY=
AUTHORIZE_CLIENT_KEY=
AUTHORIZE_GATEWAY_ID=
# [COB-48] passengerUserId de un pax SIN wallet en el carrier Authorize (gate de
# allcards-regression.api.spec.ts). Descubrible via GET passengers/carrier/{id}?lastName=
# + paymentMethodsByPax (helpers de card-precondition). En TEST 2026-07-28: 4791 (Nayla Smith).
AUTHORIZE_PASSENGER_ID=

# eBizCharge (BL-027): sandbox merchant + security key. Investigación pendiente.
EBIZ_MERCHANT_USER=
EBIZ_MERCHANT_PASSWORD=
EBIZ_SECURITY_KEY=

# Guard de operaciones DESTRUCTIVAS de pasarela (link/unlink de la pasarela activa del
# carrier compartido 1521 → cleaningWallets en cascada). Setear a true SOLO en ventana
# exclusiva. Alias legacy aceptado: AUTHORIZE_ALLOW_DESTRUCTIVE_SWITCH.
GATEWAY_ALLOW_DESTRUCTIVE_SWITCH=


# ─── Xray — Test Executions por pasarela (ATP MG-178) ────────────────────────
# Keys de los ATR por pasarela (env `test`). El reporter NO las lee directo: se pasan
# por shell como XRAY_EXECUTION_KEY al run :xray correspondiente, ej:
#   XRAY_EXECUTION_KEY=$XRAY_EXECUTION_AUTHORIZE npm run test:test:gateway:authorize:xray
# Valores actuales en docs/gateway-pg/reports/RUNBOOK-executions-por-gateway.md y en
# tests/features/gateway-pg/data/xray-keys.ts (XRAY_EXECUTIONS_TEST_ENV).
XRAY_EXECUTION_AUTHORIZE=
XRAY_EXECUTION_EBIZCHARGE=
XRAY_EXECUTION_STRIPE=
XRAY_EXECUTION_MERCADOPAGO=


# ─── Flags de ejecución E2E ──────────────────────────────────────────────────
# E2E_WEB_ONLY=true                # corre solo la fase web del flow híbrido


# ─── Google AI Studio / Gemini (pipeline doc-to-drafts) ──────────────────────
# Prefer GEMINI_API_KEY cuando el shell lo soporte;
# AI_STUDIO_GEMINI_MAGIIS es fallback del cliente compartido.
GEMINI_API_KEY=
AI_STUDIO_GEMINI_MAGIIS=
GEMINI_MODEL=

# ─── MX-6057 · countsReset (cupo) — overrides de datos del pack API/DB ────────
# Defaults en el spec apuntan a UAT (carrier 1040). Overridear si cambian los datos.
# CARRIER_ID=1040
# CARRIER_USER_ID=1380
# MX6057_CONTRACTOR_ID=1741
# MX6057_EMP_A=2098
# MX6057_ST_QUOTA=467
# MX6057_ST_HAPPY=135
# MX6057_ST_OTHER=76

# ─── Capa DB (verificación de efecto countsReset) — oracledb Thin mode, READ-ONLY ─
# Requerido SOLO para activar counts-reset-db.api.spec.ts (si faltan, ese spec skipea).
# La conexión debe ser ALCANZABLE desde el runner (el Oracle de UAT puede estar firewalleado
# desde local → correr en CI/entorno con acceso). Confirmar tabla/columnas del esquema real.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
# ORACLE_USAGE_TABLE=CONTRACTOR_EMPLOYEE_SERVICE_TYPE_USAGE
# ORACLE_USAGE_SQL=

# ─── MG · área G · vendor/cleaningWallets (desvinculación de pasarela) — pack API/DB ──
# POST /magiis-v0.2/vendor/cleaningWallets/{provider}/{carrierId}/{appId}
#   {carrierId} = userId del ADMIN del carrier (NO carrier_account.id).
#   {appId}     = MercadopagoApp.id del provider + país (en TEST difiere de UAT).
# Reusa CARRIER_ID (=1521 en TEST, carrier_account.id) + USER_CARRIER/PASS_CARRIER/BASE_URL + ORACLE_*.
# ⚠ El caso 200-happy + el spec DB son DESTRUCTIVOS (desvinculan el carrier 1521, COMPARTIDO por la
#   suite gateway). TRIPLE GATE: requieren Oracle + creds + MG25_RUN_DESTRUCTIVE=1. Default OFF.
#   Teardown de re-link NO automatizable (Stripe requiere `code` OAuth) → re-vincular manualmente.
MG25_PROVIDER=STRIPE
# MG25_CARRIER_USER_ID=            # admin userId del carrier 1521 en TEST [confirmar — no descubierto por DB]
# MG25_APP_ID=                     # MercadopagoApp.id de STRIPE en TEST [confirmar] (UAT: STRIPE=2)
MG25_RUN_DESTRUCTIVE=              # setear a 1 SOLO en entorno dedicado con teardown de re-vinculación
# Overrides opcionales de la capa DB (oracle-wallet.ts):
# ORACLE_WALLET_TABLE=USER_WALLET
# ORACLE_CARD_TABLE=CARD
# ORACLE_WALLET_SQL=               # count wallets; binds :carrierId, :appId
# ORACLE_CARD_SQL=                 # count cards; binds :carrierId, :appId
# ORACLE_WALLET_MGW_SQL=           # estado del link; binds :carrierId, :provider (agregar alias "status" si el esquema lo tiene)
